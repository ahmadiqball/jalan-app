# Jalan environment. Copy to .env and fill in for CLOUD MODE.
# Leave everything empty for LOCAL MODE: in-memory server store + stub auth +
# localStorage only (the app runs fully offline, no Supabase needed).

# ── Supabase, server-only (service role — SECRET, never exposed to the browser) ──
NUXT_SUPABASE_URL=
NUXT_SUPABASE_SERVICE_KEY=

# ── Supabase, client (Auth; also enables Google sign-in when the provider is on) ──
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Admin allowlist (comma-separated emails) — manage templates/recs at /admin ──
NUXT_ADMIN_EMAILS=

# ── pete-pete handoff (optional; defaults to https://www.petepete.in) ──
# NUXT_PUBLIC_PETE_PETE_URL=https://www.petepete.in

# ── Google Maps Embed API key (optional) ──
# Empty => maps fall back to free "open in Maps" deep links (no key, no cost).
# With a key, the day/ringkasan map previews render inline. The Embed API is
# free & unlimited; restrict the key to your domain(s) in Google Cloud Console.
# NUXT_PUBLIC_GOOGLE_MAPS_KEY=
